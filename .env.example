# ==============================================================================
# HOSPITAL MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace the placeholder values with your credentials.
# DO NOT commit your actual .env file or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Oracle FreeSQL / Oracle Database Connection Settings
# ------------------------------------------------------------------------------
# Standard TCP connection string (e.g. FreeSQL / XE / PDB):
# Format: jdbc:oracle:thin:@<host>:<port>/<service_name>
ORACLE_JDBC_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1

# Oracle Autonomous / Cloud FreeSQL with TLS or mTLS (Oracle Wallet) example:
# If using a Wallet: download wallet zip, extract into 'wallet/' directory inside project root.
# Set ORACLE_TNS_ADMIN to the absolute path of that wallet directory or use wallet URL:
# ORACLE_JDBC_URL=jdbc:oracle:thin:@dbfreesql_high?TNS_ADMIN=./wallet
# ORACLE_TNS_ADMIN=./wallet

# Oracle Database User Credentials:
ORACLE_DB_USERNAME=admin_user
ORACLE_DB_PASSWORD=your_secure_database_password

# ------------------------------------------------------------------------------
# 2. Initial Administrator Bootstrap Account
# ------------------------------------------------------------------------------
# Used ONLY if the APP_USERS table contains 0 records on initial application startup.
# The application will create this admin with a BCrypt hashed password.
APP_BOOTSTRAP_USERNAME=admin
APP_BOOTSTRAP_PASSWORD=Admin@Hospital2026

# ------------------------------------------------------------------------------
# 3. Server Configuration (Optional)
# ------------------------------------------------------------------------------
SERVER_PORT=8081
